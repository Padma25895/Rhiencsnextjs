# Copy to .env.local and fill in values from your team / dashboards.
# Never commit .env.local or any file containing real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (contact / Edge Functions as applicable)
SENDGRID_API_KEY=
ADMIN_EMAIL=
FROM_EMAIL=
FROM_NAME=

# Azure AD (reference; Edge Functions may use Supabase secrets instead)
TENANT_ID=
CLIENT_ID=
