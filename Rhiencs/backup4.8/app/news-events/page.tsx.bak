                {/* The new, attractive timeline starts here */}
                <div className="timeline">
                  {loading ? (
                    <div style={{ padding: '40px', textAlign: 'center' }}>
                      <p>Loading news and events...</p>
                    </div>
                  ) : items.length === 0 ? (
                    <div style={{ padding: '40px', textAlign: 'center' }}>
