              <div className="col-sm-6 pd0">
                <div className="parent2 retailparent2 mobileview">
                  <video
                    src="/new/histery.mp4"
                    autoPlay={true}
                    muted={true}
                    loop={true}
                    playsInline={true}
                    className="bg-image1"
                  />
                </div>
              </div>
            </div>
          </div>
