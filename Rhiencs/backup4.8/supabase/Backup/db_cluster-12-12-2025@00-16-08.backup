    client_name text,
    client_logo text,
    client_description text,
    client_location text,
    overview text,
    challenges text,
    solution text,
    benefits text,
    implementation text,
    download_url text,
    industries text[]
);


ALTER TABLE public.case_studies OWNER TO postgres;

--
-- Name: TABLE case_studies; Type: COMMENT; Schema: public; Owner: postgres
