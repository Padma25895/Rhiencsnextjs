RewriteEngine On

# Force WWW URL
RewriteCond %{HTTP_HOST} ^rheincs\.com$ [NC]
RewriteRule ^(.*)$ https://www.rheincs.com/$1 [R=301,L]

# -------------------------------
# CUSTOM 404 PAGE
# -------------------------------
ErrorDocument 404 /404.html

# -------------------------------
# FORCE HTTPS (Uncomment if needed)
# -------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]



# -------------------------------
# ENTERPRISE SOLUTIONS
# -------------------------------
RewriteRule ^enterprise-solutions/?$ https://www.rheincs.com/solutions/erp-enterprise-solutions-and-services/erp/ [R=301,L]

# -------------------------------
# MS DYNAMICS
# -------------------------------
RewriteRule ^ms-dynamics/?$ https://www.rheincs.com/solutions/erp-enterprise-solutions-and-services/ms-dynamics/ [R=301,L]


RewriteRule ^Corporate-vedio/?$ https://www.rheincs.com/corporate-videos/ [R=301,L]
# -------------------------------
# CORUS HR
# -------------------------------
RewriteRule ^CorusHR/?$ https://www.rheincs.com/solutions/CorusHR/ [R=301,L]

# -------------------------------
# DIGITAL SOLUTIONS
# -------------------------------
RewriteRule ^digital-solution-service/?$ https://www.rheincs.com/digital-solutions/ [R=301,L]
RewriteRule ^digital-solutions-services/?$ https://www.rheincs.com/digital-services/ [R=301,L]

# -------------------------------
# CUSTOMER SPEAK
# -------------------------------
RewriteRule ^customer-speak/?$ https://www.rheincs.com/about-us/customer-speak/ [R=301,L]

# -------------------------------
# CONTACT
# -------------------------------
RewriteRule ^contact/?$ https://www.rheincs.com/contact-us/ [R=301,L]

# -------------------------------
# LEADERSHIP
# -------------------------------
RewriteRule ^leadership/?$ https://www.rheincs.com/about-us/leadership/ [R=301,L]

# -------------------------------
# EPICOR
# -------------------------------
RewriteRule ^epicor/?$ https://www.rheincs.com/solutions/erp-enterprise-solutions-and-services/epicor/ [R=301,L]

# -------------------------------
# EPC
# -------------------------------
RewriteRule ^Epc/?$ https://www.rheincs.com/Engineering-Procurement-Construction-(EPC)/ [R=301,L]

# -------------------------------
# SITEMAP - Block subpaths, allow exact /sitemap only
# -------------------------------
# RewriteRule ^sitemap/.*\.php$ - [G,L]
# RewriteRule ^sitemap(/.+|/)$ - [G,L]
# RewriteRule ^sitemap$ sitemap.php [L]

# Block direct access to sitemap.php
RewriteCond %{THE_REQUEST} \s/+sitemap\.php [NC]
RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L]

# Internally serve sitemap.php when sitemap.xml is requested
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]

# -------------------------------
# DEFAULT NEXT.JS / HOSTINGER RULE
# -------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]


RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule ^LP/.*$ /404.html [L]
  RewriteRule ^EbookLanding/.*$ /404.html [L]
  
  
  # -------------------------------
# BLOG
# -------------------------------

# Redirect /Blog to /blogs
RewriteRule ^Blog/?$ https://www.rheincs.com/blogs/ [R=301,L,NC]

# Redirect /Blog/post-name to /blogs/post-name
RewriteRule ^Blog/(.+)$ https://www.rheincs.com/blogs/$1 [R=301,L,NC]
  

##########################################
# Enable Compression
##########################################

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

##########################################
# Browser Cache
##########################################

<IfModule mod_expires.c>

    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

</IfModule>

##########################################
# Cache-Control
##########################################

<IfModule mod_headers.c>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|woff|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>

##########################################
# Remove ETag
##########################################

FileETag None

<IfModule mod_headers.c>
    Header unset ETag
</IfModule>


