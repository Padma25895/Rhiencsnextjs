# Apache .htaccess for handling 404 errors with Next.js static export
# This ensures unmatched routes serve the 404.html file which contains client-side routing

# Enable rewrite engine
RewriteEngine On

# Serve 404.html for all unmatched routes
# This allows the custom 404 page to handle dynamic routes client-side
ErrorDocument 404 /404.html

# Optional: Force HTTPS (uncomment if needed)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

